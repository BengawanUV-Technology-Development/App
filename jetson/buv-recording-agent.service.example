[Unit]
Description=BUV Jetson high-resolution recording agent
After=network-online.target nvargus-daemon.service
Wants=network-online.target
RequiresMountsFor=/media/<user>/<ssd-label>/flight-recordings

[Service]
Type=simple
User=jetson
WorkingDirectory=/opt/buv-app
EnvironmentFile=/etc/buv/jetson-recording.env
ExecStart=/usr/bin/python3 /opt/buv-app/jetson/recording_agent.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
