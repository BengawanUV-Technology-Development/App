# Jetson recording-agent configuration. Export these variables before starting
# recording_agent.py, or place them in the systemd EnvironmentFile.

JETSON_RECORDING_AGENT_BIND_ADDRESS=0.0.0.0
JETSON_RECORDING_AGENT_PORT=5101
JETSON_RECORDING_AGENT_TOKEN=replace_with_shared_private_token

# Tailscale hostname/IP of the GCS machine receiving the low-res RTP stream.
JETSON_GCS_HOST=100.x.y.z

JETSON_VIDEO_PORT=5000
JETSON_VIDEO_PAYLOAD_TYPE=96
JETSON_SENSOR_ID=0

# High-res is used for local evidence and YOLO/SAHI.
JETSON_HIGH_WIDTH=1920
JETSON_HIGH_HEIGHT=1080
JETSON_HIGH_FPS=30
JETSON_LOCAL_BITRATE_KBPS=12000

# Only this branch crosses the network to GCS.
JETSON_NETWORK_WIDTH=960
JETSON_NETWORK_HEIGHT=540
JETSON_NETWORK_FPS=15
JETSON_NETWORK_BITRATE_KBPS=2000

JETSON_RECORD_DIR=/data/flight-recordings

# Optional detector configuration. Leave weights empty for capture-only tests.
# JETSON_MODEL_WEIGHTS=/absolute/path/to/best.pt
JETSON_MODEL_DEVICE=cuda:0
JETSON_MODEL_IMGSZ=640
JETSON_MODEL_CONF=0.45
JETSON_MODEL_SAHI=true
JETSON_MODEL_SAHI_STANDARD_PRED=false
JETSON_MODEL_SLICE_WIDTH=640
JETSON_MODEL_SLICE_HEIGHT=640
JETSON_MODEL_OVERLAP=0.2

# Defaults to the GCS overlay endpoint derived from JETSON_GCS_HOST.
# JETSON_DETECTION_INGEST_URL=http://100.x.y.z:5001/api/v1/detection/overlay
