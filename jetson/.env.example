# Jetson recording-agent configuration. Export these variables before starting
# recording_agent.py, or place them in the systemd EnvironmentFile.

JETSON_RECORDING_AGENT_BIND_ADDRESS=0.0.0.0
JETSON_RECORDING_AGENT_PORT=5101
JETSON_RECORDING_AGENT_TOKEN=replace_with_shared_private_token

# The recording agent automatically uses the IPv4 address that calls
# /recording/start as the RTP/detection destination. This optional fallback is
# only needed for legacy callers that do not connect directly from the GCS.
# JETSON_GCS_HOST=100.x.y.z
JETSON_GCS_API_PORT=5001

# Explicit gcs_host overrides are rejected unless routing/proxying requires
# them. Keep this false for a direct GCS -> Jetson Tailscale connection.
JETSON_ALLOW_GCS_HOST_OVERRIDE=false

JETSON_VIDEO_PORT=5000
JETSON_VIDEO_PAYLOAD_TYPE=96
JETSON_SENSOR_ID=0

# High-res is used for local evidence and YOLO/SAHI.
JETSON_HIGH_WIDTH=1920
JETSON_HIGH_HEIGHT=1080
JETSON_HIGH_FPS=30
JETSON_LOCAL_BITRATE_KBPS=12000

# Only this branch crosses the network to GCS.
JETSON_NETWORK_WIDTH=960
JETSON_NETWORK_HEIGHT=540
JETSON_NETWORK_FPS=15
JETSON_NETWORK_BITRATE_KBPS=2000

# Keep flight evidence on the mounted SSD, never under /home.
# Change this only if the SSD mount point is different on the Jetson.
JETSON_RECORD_DIR=/media/<user>/<ssd-label>/flight-recordings
JETSON_RECORD_MOUNTPOINT=/media/<user>/<ssd-label>
JETSON_RECORD_MIN_FREE_GB=10
JETSON_STORAGE_GUARD=true
JETSON_EOS_TIMEOUT_SECONDS=30
JETSON_STOP_TIMEOUT_SECONDS=60

# Read-only telemetry path. mavlink-router reads the flight controller from
# /dev/ttyACM0 and exposes the MAVLink stream to this collector over TCP.
# Mission Planner is not required for the recorder.
JETSON_MAVLINK_TCP_HOST=127.0.0.1
JETSON_MAVLINK_TCP_PORT=5760
JETSON_MAVLINK_CONNECT_TIMEOUT_SECONDS=1.0
JETSON_MAVLINK_RECONNECT_SECONDS=2.0
JETSON_MAVLINK_STALE_AFTER_SECONDS=2.0

# Optional detector configuration. Leave weights empty for capture-only tests.
# Leave JETSON_MODEL_WEIGHTS empty for flight capture without YOLO.
# Enable it only for a later detector run on the Jetson.
# JETSON_MODEL_WEIGHTS=/absolute/path/to/best.pt
JETSON_MODEL_DEVICE=cuda:0
JETSON_MODEL_IMGSZ=640
JETSON_MODEL_CONF=0.45
JETSON_MODEL_SAHI=false
JETSON_MODEL_SAHI_STANDARD_PRED=false
JETSON_MODEL_SLICE_WIDTH=640
JETSON_MODEL_SLICE_HEIGHT=640
JETSON_MODEL_OVERLAP=0.2

# Defaults to the runtime GCS address and API port selected at recording start.
# JETSON_DETECTION_INGEST_URL=http://100.x.y.z:5001/api/v1/detection/overlay
