[Unit]
Description=BUV Jetson camera preview (canonical app-mavproxy runtime)
After=network-online.target tailscaled.service nvargus-daemon.service
Wants=network-online.target
Requires=nvargus-daemon.service

[Service]
Type=simple
User=bengawan
Group=video
WorkingDirectory=/home/bengawan/Documents/app-mavproxy
EnvironmentFile=/etc/buv/jetson-recording-target.env
Environment=JETSON_VIDEO_PORT=5000
Environment=JETSON_VIDEO_PAYLOAD_TYPE=96
Environment=JETSON_NETWORK_WIDTH=960
Environment=JETSON_NETWORK_HEIGHT=540
Environment=JETSON_NETWORK_FPS=15
Environment=JETSON_NETWORK_BITRATE_KBPS=2000
Environment=JETSON_EASYCAP_DEVICE=/dev/v4l/by-id/usb-ARKMICRO_USB2.0_PC_CAMERA-video-index0
Environment=JETSON_EASYCAP_WIDTH=640
Environment=JETSON_EASYCAP_HEIGHT=480
Environment=JETSON_EASYCAP_FPS=30
Environment=JETSON_PREVIEW_SOURCE_FILE=/media/bengawan/nopal-ssd1/flight-recordings/.preview-source
Environment=JETSON_RECORDING_ACTIVE_FILE=/media/bengawan/nopal-ssd1/flight-recordings/.recording-agent.active.json
ExecStart=/usr/bin/python3 /home/bengawan/Documents/app-mavproxy/jetson/camera_stream_service.py
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
