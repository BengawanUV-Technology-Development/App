# Configuration file for BUV Backend

# API Port for the Flask Server
API_PORT=5001

# Three independent bearer credentials. Never expose these through VITE_*.
BUV_OPERATOR_TOKEN=replace_with_operator_session_token
JETSON_INGEST_TOKEN=replace_with_jetson_ingest_token
JETSON_RECORDING_AGENT_TOKEN=replace_with_recording_agent_token
BUV_DATABASE_PATH=runtime/buv.sqlite3

# Google Gemini API Key for AI Agent Orchestrator
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Camera source. The production path receives Arducam H.264/RTP/UDP from the
# Jetson. The v0.3 release rejects every non-Arducam source.
CAMERA_SOURCE=jetson_udp

# Jetson H.264/RTP/UDP receiver. The sender's port, payload type, and caps
# must match these values. Keep the UDP port private to the Tailscale network.
JETSON_VIDEO_BIND_ADDRESS=0.0.0.0
JETSON_VIDEO_PORT=5000
JETSON_VIDEO_PAYLOAD_TYPE=96
JETSON_VIDEO_JITTER_LATENCY_MS=80
# Keep these equal to the sender's network branch so bbox_network coordinates
# map directly onto the decoded GCS preview.
JETSON_VIDEO_PREVIEW_WIDTH=960
JETSON_VIDEO_PREVIEW_HEIGHT=540
JETSON_VIDEO_FPS=15
JETSON_VIDEO_FRAME_TIMEOUT_SECONDS=5
JETSON_VIDEO_PREVIEW_JPEG_QUALITY=75
JETSON_VIDEO_DECODER=avdec_h264
JETSON_VIDEO_AUTOSTART=true

# API_PORT and JETSON_VIDEO_PORT are sent to the Jetson at recording start.
# The Jetson detects this GCS machine's IPv4 address from the authenticated
# control connection, so no GCS destination IP is configured on the Jetson.

# Latest YOLO/SAHI boxes expire when the detector or stream stops publishing.
DETECTION_OVERLAY_TTL_SECONDS=1.0

# The ground-side video/bbox synchronizer (app/routes/api_v1.py) shows a
# video frame the instant it decodes and only attaches a detection if one
# already arrived for that exact frame -- it never holds video waiting for
# one. An earlier fixed wait-then-timeout design was tried (150ms, then
# 400ms, then 700ms) and dropped: it forced the entire live feed to lag by
# that window since every frame was held for the same wait, not just the
# ones that ended up matched. Detections that miss the instant-match window
# are reviewed post-flight from the recording instead (see
# docs/post-flight-detection-snapshots.md), not live.

# The website recording button controls the high-res recorder on Jetson.
# Do not point this at the GCS machine; use the Jetson Tailscale address.
JETSON_RECORDING_AGENT_URL=http://JETSON_TAILSCALE_IP:5101
JETSON_RECORDING_AGENT_TOKEN=replace_with_shared_private_token
JETSON_RECORDING_AGENT_TIMEOUT_SECONDS=1.0

# Ground-side telemetry history (app/services/telemetry_recorder.py). Every
# telemetry sample the Mission Planner bridge successfully returns is
# appended here and kept in a short in-memory buffer, independent of the
# Jetson's own onboard telemetry.jsonl.
BUV_GROUND_TELEMETRY_LOG=runtime/ground_telemetry.jsonl
# How far (in seconds) a buffered telemetry sample may be from a detection's
# capture time and still be used to estimate that target's coordinate.
BUV_TELEMETRY_JOIN_WINDOW_SECONDS=0.5

# Ground-side target coordinate estimation (app/services/coordinate_estimator.py).
# THESE ARE PLACEHOLDER VALUES borrowed from the Coordinate-Estimator research
# prototype, NOT measured against the physical Arducam. Leave
# JETSON_CAMERA_CALIBRATED=false (the default) until you have replaced the
# intrinsics below with real datasheet/calibration values and verified the
# mount angles against the actual airframe install -- until then every
# estimate is tagged "status": "ESTIMATED_UNCALIBRATED", not to be trusted
# for scoring.
JETSON_CAMERA_FOCAL_LENGTH_MM=6.0
JETSON_CAMERA_SENSOR_WIDTH_MM=6.287
# Fine-adjustment offset from the assumed canonical nadir mount (boresight
# straight down, top-of-image toward the nose). Leave at 0 unless the camera
# is physically tilted/rotated relative to that.
JETSON_CAMERA_MOUNT_ROLL_DEG=0.0
JETSON_CAMERA_MOUNT_PITCH_DEG=0.0
JETSON_CAMERA_MOUNT_YAW_DEG=0.0
JETSON_CAMERA_CALIBRATED=false
