# Configuration file for BUV Backend

# API Port for the Flask Server
API_PORT=5001

# Google Gemini API Key for AI Agent Orchestrator
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# VRX RD945 -> EasyCAP flight recorder
# Run the backend natively on Windows for DirectShow capture access.
FLIGHT_RECORDINGS_DIR=recordings
VRX_CAMERA_INDEX=0
VRX_CAPTURE_WIDTH=640
VRX_CAPTURE_HEIGHT=480
VRX_CAPTURE_FPS=25
VRX_VIDEO_STANDARD=PAL
VRX_VIDEO_CODEC=mp4v
