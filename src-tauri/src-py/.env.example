# Configuration file for BUV Backend

# API Port for the Flask Server
API_PORT=5001

# Three independent bearer credentials. Never expose these through VITE_*.
BUV_OPERATOR_TOKEN=replace_with_operator_session_token
JETSON_INGEST_TOKEN=replace_with_jetson_ingest_token
JETSON_RECORDING_AGENT_TOKEN=replace_with_recording_agent_token
BUV_DATABASE_PATH=runtime/buv.sqlite3

# Google Gemini API Key for AI Agent Orchestrator
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Camera source. The production path receives Arducam H.264/RTP/UDP from the
# Jetson. The v0.3 release rejects every non-Arducam source.
CAMERA_SOURCE=jetson_udp

# Jetson H.264/RTP/UDP receiver. The sender's port, payload type, and caps
# must match these values. Keep the UDP port private to the Tailscale network.
JETSON_VIDEO_BIND_ADDRESS=0.0.0.0
JETSON_VIDEO_PORT=5000
JETSON_VIDEO_PAYLOAD_TYPE=96
JETSON_VIDEO_JITTER_LATENCY_MS=80
# Keep these equal to the sender's network branch so bbox_network coordinates
# map directly onto the decoded GCS preview.
JETSON_VIDEO_PREVIEW_WIDTH=960
JETSON_VIDEO_PREVIEW_HEIGHT=540
JETSON_VIDEO_FPS=15
JETSON_VIDEO_FRAME_TIMEOUT_SECONDS=5
JETSON_VIDEO_PREVIEW_JPEG_QUALITY=75
JETSON_VIDEO_GST_LAUNCH=gst-launch-1.0
JETSON_VIDEO_DECODER=avdec_h264
JETSON_VIDEO_AUTOSTART=true

# API_PORT and JETSON_VIDEO_PORT are sent to the Jetson at recording start.
# The Jetson detects this GCS machine's IPv4 address from the authenticated
# control connection, so no GCS destination IP is configured on the Jetson.

# Latest YOLO/SAHI boxes expire when the detector or stream stops publishing.
DETECTION_OVERLAY_TTL_SECONDS=1.0

# The website recording button controls the high-res recorder on Jetson.
# Do not point this at the GCS machine; use the Jetson Tailscale address.
JETSON_RECORDING_AGENT_URL=http://JETSON_TAILSCALE_IP:5101
JETSON_RECORDING_AGENT_TOKEN=replace_with_shared_private_token
JETSON_RECORDING_AGENT_TIMEOUT_SECONDS=1.0
