# Copy the values into the backend environment when enabling the Jetson feed.
# The Jetson sender and this receiver must use the same port, payload type,
# resolution, and frame rate.
JETSON_VIDEO_BIND_ADDRESS=0.0.0.0
JETSON_VIDEO_PORT=5000
JETSON_VIDEO_PAYLOAD_TYPE=96
JETSON_VIDEO_JITTER_LATENCY_MS=80
JETSON_VIDEO_PREVIEW_WIDTH=960
JETSON_VIDEO_PREVIEW_HEIGHT=540
JETSON_VIDEO_FPS=15
JETSON_VIDEO_FRAME_TIMEOUT_SECONDS=5
JETSON_VIDEO_PREVIEW_JPEG_QUALITY=75
JETSON_VIDEO_DECODER=avdec_h264

# Authenticated control plane for CSI/analog selection and recording.
JETSON_RECORDING_AGENT_URL=http://100.124.21.25:5101
JETSON_RECORDING_AGENT_TOKEN=replace-with-the-token-from-the-jetson
# Explicit RTP/recording callback target. Fill in the Ground laptop's current
# Tailscale IPv4 address; leave empty only when the request source IP is valid.
JETSON_GCS_HOST=<GROUND_TAILSCALE_IPV4>
JETSON_RECORDING_AGENT_TIMEOUT_SECONDS=8

# Jetson -> Ground detection callback. This must equal the Jetson
# JETSON_INGEST_TOKEN; keep the value out of git and out of the UI.
VISION_INGEST_TOKEN=replace-with-the-jetson-ingest-token

# Coordinate output is deliberately disabled until Arducam calibration,
# measured mounting orientation, and reliable AGL are available.
VISION_COORDINATE_ENABLED=false
VISION_COORDINATE_CALIBRATION_PATH=
VISION_ALTITUDE_REFERENCE=
VISION_CAMERA_ATTITUDE_FRAME=
VISION_TIMELINE_SIZE=8192
VISION_RECENT_DETECTION_LIMIT=64
